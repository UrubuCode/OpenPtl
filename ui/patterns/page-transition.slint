import { Theme } from "../theme/tokens.slint";

/// Entrada de página: sobe alguns pixels enquanto aparece, a mesma ideia do
/// `fade-in-up` do design anterior. Como cada seção só existe enquanto está
/// ativa, o `init` dispara a transição a cada troca.
export component PageTransition inherits Rectangle {
    property <bool> revealed: false;

    init => {
        self.revealed = true;
    }

    y: root.revealed ? 0px : Theme.rise;
    opacity: root.revealed ? 1.0 : 0.0;

    animate y, opacity {
        duration: Theme.motion-slow;
        easing: Theme.ease-out-soft;
    }

    @children
}
