import { Theme } from "../theme/tokens.slint";
import { Type } from "../theme/typography.slint";
import { UiCard } from "../components/card.slint";
import { FocusSink } from "focus-sink.slint";

export component Modal inherits Rectangle {
    in property <bool> open: false;
    in property <string> title;
    in property <length> panel-width: 460px;
    callback dismissed();

    // Fica na árvore mesmo fechado para a transição ter de onde partir; o
    // `visible` só desliga depois que a saída termina.
    visible: root.open || root.veil > 0.01;
    background: Theme.overlay.with-alpha(0.72 * root.veil);

    property <float> veil: root.open ? 1.0 : 0.0;
    animate veil {
        duration: Theme.motion-base;
        easing: Theme.ease-smooth;
    }

    TouchArea {
        clicked => { root.dismissed(); }
    }

    UiCard {
        raised: true;
        width: root.panel-width;
        height: content.min-height;

        // Entra subindo e crescendo de leve, a mesma ideia do fade-in-up.
        y: (parent.height - self.height) / 2 + (1 - root.veil) * Theme.rise * 2;
        opacity: root.veil;
        animate y, opacity {
            duration: Theme.motion-base;
            easing: Theme.ease-out-soft;
        }

        // Impede que o clique dentro do painel chegue ao veu e feche o modal,
        // e tira o foco de um campo quando o clique vai para o vazio.
        FocusSink { }

        content := VerticalLayout {
            padding: Theme.space-lg;
            spacing: Theme.space-md;

            Text {
                text: root.title;
                font-size: Type.title;
                font-weight: Type.weight-semibold;
                color: Theme.text-primary;
            }

            @children
        }
    }
}
