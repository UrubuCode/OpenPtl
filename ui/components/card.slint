import { Theme } from "../theme/tokens.slint";

export component UiCard inherits Rectangle {
    in property <bool> selected: false;
    in property <bool> raised: false;

    background: root.raised ? Theme.surface-raised : Theme.surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.border;

    animate border-color { duration: Theme.motion-fast; }
}
