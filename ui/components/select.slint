import { Theme } from "../theme/tokens.slint";
import { Type } from "../theme/typography.slint";
import { UiIcon, Icons } from "./icon.slint";

export struct SelectOption {
    id: string,
    label: string,
}

component OptionRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback picked();

    height: 30px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    animate background { duration: Theme.motion-fast; }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.picked(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;

        Text {
            horizontal-stretch: 1;
            text: root.label;
            vertical-alignment: center;
            font-size: Type.label;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
            overflow: elide;
        }

        if root.selected: UiIcon {
            width: 13px;
            height: 13px;
            y: (parent.height - self.height) / 2;
            source: Icons.check;
            tint: Theme.accent;
        }
    }
}

/// Lista suspensa. Escolher uma chave do chaveiro por digitação era pedir para
/// o usuário decorar identificadores; aqui ele escolhe pelo nome.
///
/// A lista abre num `PopupWindow`: como elemento normal ela entrava no fluxo do
/// layout e empurrava o resto do formulário para baixo ao abrir.
export component UiSelect inherits VerticalLayout {
    in property <string> label;
    in property <[SelectOption]> options;
    in property <string> placeholder: "Nenhum";
    in-out property <string> current;
    /// Rótulo exibido. O Slint não tem laço dentro de função, então quem
    /// escolhe também informa o rótulo, e o pai passa o inicial.
    in-out property <string> current-label;
    callback selected(string);

    spacing: Theme.space-xs;
    vertical-stretch: 0;

    if root.label != "": Text {
        text: root.label;
        font-size: Type.caption;
        color: Theme.text-muted;
    }

    Rectangle {
        height: Theme.control-height;
        vertical-stretch: 0;
        background: Theme.surface-inset;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border;

        HorizontalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;
            spacing: Theme.space-sm;

            Text {
                horizontal-stretch: 1;
                text: root.current == "" ? root.placeholder : root.current-label;
                vertical-alignment: center;
                font-size: Type.body;
                color: root.current == "" ? Theme.text-muted : Theme.text-primary;
                overflow: elide;
            }

            UiIcon {
                width: 14px;
                height: 14px;
                y: (parent.height - self.height) / 2;
                source: Icons.chevron-down;
                tint: Theme.text-muted;
            }
        }

        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { menu.show(); }
        }

        menu := PopupWindow {
            y: parent.height + 4px;
            width: parent.width;
            height: list.min-height;
            close-policy: close-on-click-outside;

            Rectangle {
                background: Theme.surface-raised;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-strong;

                list := VerticalLayout {
                    padding: 3px;

                    OptionRow {
                        label: root.placeholder;
                        selected: root.current == "";
                        picked => {
                            root.current = "";
                            root.current-label = "";
                            root.selected("");
                        }
                    }

                    for option in root.options: OptionRow {
                        label: option.label;
                        selected: option.id == root.current;
                        picked => {
                            root.current = option.id;
                            root.current-label = option.label;
                            root.selected(option.id);
                        }
                    }
                }
            }
        }
    }
}
