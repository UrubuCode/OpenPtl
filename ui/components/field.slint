import { Theme } from "../theme/tokens.slint";
import { Type } from "../theme/typography.slint";
import { UiIcon, Icons } from "./icon.slint";

// `LineEdit` do std-widgets desenha o próprio Rectangle com fundo, borda e raio
// da paleta Fluent. Envolvê-lo produzia duas molduras sobrepostas, a de dentro
// com cores claras brigando com o tema. Usamos `TextInput`, que é só o texto,
// e a moldura fica sendo apenas esta.
export component UiField inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> secret: false;
    /// Mostra o olho que revela o conteudo, para conferir o que foi digitado.
    in property <bool> revealable: false;
    property <bool> revealed: false;
    in property <bool> enabled: true;
    in-out property <string> value;
    callback accepted();

    spacing: Theme.space-xs;
    // Sem isto o campo estica dentro do formulario e o espaco extra vira uma
    // lacuna entre o rotulo e a caixa de texto.
    vertical-stretch: 0;

    if root.label != "": Text {
        text: root.label;
        font-family: Type.family;
        font-size: Type.caption;
        color: Theme.text-muted;
    }

    Rectangle {
        height: Theme.control-height;
        vertical-stretch: 0;
        background: root.enabled ? Theme.surface-inset : Theme.surface;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        animate border-color { duration: Theme.motion-fast; }

        HorizontalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;

            Rectangle {
                clip: true;

                if root.value == "" && !input.has-focus: Text {
                    x: 0;
                    text: root.placeholder;
                    vertical-alignment: center;
                    font-family: Type.family;
                    font-size: Type.body;
                    color: Theme.text-muted;
                }

                input := TextInput {
                    x: 0;
                    width: max(parent.width, self.preferred-width);
                    enabled: root.enabled;
                    single-line: true;
                    vertical-alignment: center;
                    font-family: Type.family;
                    font-size: Type.body;
                    color: root.enabled ? Theme.text-primary : Theme.text-muted;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.text-on-accent;
                    input-type: root.secret && !root.revealed ? InputType.password : InputType.text;
                    text <=> root.value;
                    accepted => { root.accepted(); }
                }
            }

            if root.revealable: Rectangle {
                width: 26px;
                y: (parent.height - self.height) / 2;
                height: 26px;
                border-radius: Theme.radius-sm;
                background: eye-touch.has-hover ? Theme.surface-hover : transparent;
                animate background { duration: Theme.motion-fast; }

                UiIcon {
                    width: 14px;
                    height: 14px;
                    source: root.revealed ? Icons.eye-off : Icons.eye;
                    tint: eye-touch.has-hover ? Theme.text-secondary : Theme.text-muted;
                }

                eye-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.revealed = !root.revealed; }
                }
            }
        }
    }
}
