import { Theme } from "../theme/tokens.slint";
import { Type } from "../theme/typography.slint";

/// Interruptor. Substituiu a caixa de seleção: para uma preferência que liga e
/// desliga na hora, o estado fica mais evidente com o botão deslizando.
///
/// A raiz é um `Rectangle`, não um layout. Como filha de `HorizontalLayout`, a
/// `TouchArea` virava mais um item da linha e ocupava um pedaço dela, em vez de
/// cobrir o componente — daí o clique cair torto.
export component UiToggle inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled();

    height: 26px;
    vertical-stretch: 0;

    HorizontalLayout {
        spacing: Theme.space-md;

        track := Rectangle {
            width: 36px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            horizontal-stretch: 0;
            border-radius: 10px;
            opacity: root.enabled ? 1.0 : 0.45;
            background: root.checked ? Theme.accent : Theme.surface-inset;
            border-width: 1px;
            border-color: root.checked ? Theme.accent-bright : Theme.border-strong;
            animate background, border-color {
                duration: Theme.motion-fast;
                easing: Theme.ease-smooth;
            }

            Rectangle {
                width: 14px;
                height: 14px;
                y: (parent.height - self.height) / 2;
                x: root.checked ? parent.width - self.width - 3px : 3px;
                border-radius: 7px;
                background: root.checked ? Theme.text-on-accent : Theme.text-muted;
                animate x, background {
                    duration: Theme.motion-base;
                    easing: Theme.ease-out-soft;
                }
            }
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            vertical-alignment: center;
            font-size: Type.body;
            color: root.enabled ? Theme.text-secondary : Theme.text-muted;
        }
    }

    // Fora do layout: cobre o componente inteiro, trilho e rótulo.
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}
