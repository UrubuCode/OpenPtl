import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Type } from "../theme/typography.slint";
import { Palette } from "../theme/palette.slint";
import { TermLine } from "../models/terminal.slint";

/// Superfície de saída do terminal.
///
/// Cada trecho recebe largura fixa, calculada pelo número de células que ocupa.
/// Sem isso o texto era posicionado pela largura natural de cada pedaço e as
/// colunas não fechavam — tabelas e desenhos de caixa saíam tortos, mesmo com
/// fonte monoespaçada.
export component TerminalView inherits Rectangle {
    in property <[TermLine]> lines;
    in property <bool> focused: false;
    callback key-pressed(string, bool, bool);
    /// Tamanho útil e tamanho da célula, ambos em pixels. A célula vai junto
    /// porque só a interface sabe medir a fonte; o Rust converte em colunas e
    /// linhas.
    callback surface-resized(length, length, length, length);

    /// Medidor da fonte monoespaçada.
    ///
    /// A largura da célula era uma constante de 7px, chutada para o Consolas
    /// em 13px. O avanço real não é exatamente isso, e o erro se acumulava a
    /// cada coluna: no fim da linha o texto já não caía sobre o retângulo que
    /// deveria ocupar. Medir dez zeros e dividir dá o avanço verdadeiro, seja
    /// qual for a fonte que o sistema entregou.
    metrics := Text {
        visible: false;
        text: "0000000000";
        font-family: Type.mono-family;
        font-size: Type.mono-size;
    }

    property <length> cell-width: metrics.preferred-width / 10;
    property <length> cell-height: metrics.preferred-height;

    background: Theme.overlay;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: root.focused ? Theme.accent : Theme.border;
    forward-focus: input;
    clip: true;

    function report-size() {
        root.surface-resized(self.width, self.height, root.cell-width, root.cell-height);
    }

    changed width => { root.report-size(); }
    changed height => { root.report-size(); }
    init => { root.report-size(); }

    ScrollView {
        VerticalLayout {
            padding: Theme.space-md;
            spacing: 0px;
            alignment: start;

            for line in root.lines: HorizontalLayout {
                spacing: 0px;
                alignment: start;
                height: root.cell-height;

                for span in line.spans: Rectangle {
                    width: span.cells * root.cell-width;
                    // Recorta: o negrito costuma avançar mais que o regular e,
                    // sem isto, invadia a coluna seguinte.
                    clip: true;
                    background: span.inverse
                        ? Palette.foreground(span.foreground, span.foreground-rgb)
                        : Palette.background(span.background, span.background-rgb);

                    Text {
                        text: span.text;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        font-family: Type.mono-family;
                        font-size: Type.mono-size;
                        font-weight: span.bold ? Type.weight-bold : Type.weight-regular;
                        color: span.inverse
                            ? Theme.overlay
                            : Palette.foreground(span.foreground, span.foreground-rgb);
                    }
                }
            }
        }
    }

    input := FocusScope {
        key-pressed(event) => {
            root.key-pressed(event.text, event.modifiers.control, event.modifiers.alt);
            return accept;
        }
    }
}
