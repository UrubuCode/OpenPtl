import { Theme } from "../theme/tokens.slint";

/// Ícones da interface, do conjunto Lucide via Iconify, em `assets/icons`.
///
/// Glifos de texto não servem: dependem de a fonte instalada ter aquele ponto
/// de código, e quando não tem o sistema desenha um retângulo vazio. Os SVGs
/// foram normalizados para 24 por 24 com traço branco, para que `colorize`
/// possa tingi-los com a cor do tema.
export global Icons {
    out property <image> workspace: @image-url("../../assets/icons/workspace.svg");
    out property <image> connections: @image-url("../../assets/icons/connections.svg");
    out property <image> terminal: @image-url("../../assets/icons/terminal.svg");
    out property <image> files: @image-url("../../assets/icons/files.svg");
    out property <image> editor: @image-url("../../assets/icons/editor.svg");
    out property <image> keychain: @image-url("../../assets/icons/keychain.svg");
    out property <image> shield: @image-url("../../assets/icons/shield.svg");
    out property <image> notes: @image-url("../../assets/icons/notes.svg");
    out property <image> sync: @image-url("../../assets/icons/sync.svg");
    out property <image> settings: @image-url("../../assets/icons/settings.svg");
    out property <image> about: @image-url("../../assets/icons/about.svg");

    out property <image> folder: @image-url("../../assets/icons/folder-arrow.svg");
    out property <image> file: @image-url("../../assets/icons/file-dot.svg");
    out property <image> check: @image-url("../../assets/icons/check.svg");
    out property <image> close: @image-url("../../assets/icons/close.svg");
    out property <image> minimize: @image-url("../../assets/icons/minimize.svg");
    out property <image> maximize: @image-url("../../assets/icons/maximize.svg");
    out property <image> restore: @image-url("../../assets/icons/restore.svg");
    out property <image> menu: @image-url("../../assets/icons/menu.svg");
    out property <image> plus: @image-url("../../assets/icons/plus.svg");
    out property <image> download: @image-url("../../assets/icons/download.svg");
    out property <image> upload: @image-url("../../assets/icons/upload.svg");
    out property <image> trash: @image-url("../../assets/icons/trash.svg");
    out property <image> pencil: @image-url("../../assets/icons/pencil.svg");
    out property <image> save: @image-url("../../assets/icons/save.svg");
    out property <image> reload: @image-url("../../assets/icons/reload.svg");
    out property <image> parent: @image-url("../../assets/icons/parent.svg");
    out property <image> grip: @image-url("../../assets/icons/grip.svg");
    out property <image> eye: @image-url("../../assets/icons/eye.svg");
    out property <image> eye-off: @image-url("../../assets/icons/eye-off.svg");
    out property <image> panel-left: @image-url("../../assets/icons/panel-left.svg");
    out property <image> search: @image-url("../../assets/icons/search.svg");
    out property <image> chevron-down: @image-url("../../assets/icons/chevron-down.svg");
    out property <image> home: @image-url("../../assets/icons/home.svg");
    out property <image> logs: @image-url("../../assets/icons/logs.svg");
    out property <image> lock: @image-url("../../assets/icons/lock.svg");
    out property <image> paste: @image-url("../../assets/icons/paste.svg");
    out property <image> server: @image-url("../../assets/icons/server.svg");
    out property <image> warning: @image-url("../../assets/icons/warning.svg");
    out property <image> app: @image-url("../../assets/icons/app.svg");
    out property <image> sftp: @image-url("../../assets/icons/sftp.svg");
    out property <image> security: @image-url("../../assets/icons/security.svg");
    out property <image> terminal-tab: @image-url("../../assets/icons/terminal-tab.svg");
    out property <image> plus-circle: @image-url("../../assets/icons/plus-circle.svg");
    out property <image> user: @image-url("../../assets/icons/user.svg");
    out property <image> key: @image-url("../../assets/icons/key.svg");
}

export component UiIcon inherits Image {
    in property <brush> tint: Theme.text-muted;

    width: 16px;
    height: 16px;
    image-fit: contain;
    colorize: root.tint;

    animate colorize { duration: Theme.motion-fast; }
}
