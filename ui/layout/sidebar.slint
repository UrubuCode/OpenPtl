import { Theme } from "../theme/tokens.slint";
import { Type } from "../theme/typography.slint";

export enum Section { home, terminal, files, editor, keychain, known-hosts, notes, sync, settings, about }

component SidebarItem inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> active: false;
    in property <bool> collapsed: false;
    callback clicked();

    height: 34px;
    border-radius: Theme.radius-md;
    background: root.active ? Theme.sidebar-active
        : touch.has-hover ? Theme.surface
        : transparent;
    animate background {
        duration: Theme.motion-fast;
        easing: Theme.ease-smooth;
    }

    // Traço de seleção que cresce a partir do topo, em vez de piscar.
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.active ? 18px : 0px;
        border-radius: 2px;
        background: Theme.accent;
        animate height {
            duration: Theme.motion-base;
            easing: Theme.ease-out-soft;
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-sm;
        spacing: Theme.space-md;

        Text {
            width: 16px;
            text: root.glyph;
            vertical-alignment: center;
            horizontal-alignment: center;
            font-size: Type.body;
            color: root.active ? Theme.accent : Theme.sidebar-text;
        }

        Text {
            horizontal-stretch: 1;
            text: root.label;
            vertical-alignment: center;
            font-size: Type.body;
            font-weight: root.active ? Type.weight-medium : Type.weight-regular;
            color: root.active ? Theme.text-primary : Theme.sidebar-text;
            opacity: root.collapsed ? 0 : 1;
            animate opacity { duration: Theme.motion-fast; }
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component Sidebar inherits Rectangle {
    in property <Section> active;
    in property <bool> collapsed: false;
    callback selected(Section);

    // Recolhida vira uma faixa de ícones; o conteúdo ao lado ganha o espaço.
    width: root.collapsed ? 56px : Theme.sidebar-width;
    background: Theme.sidebar;
    clip: true;
    animate width {
        duration: Theme.motion-base;
        easing: Theme.ease-smooth;
    }

    Rectangle {
        width: 1px;
        x: parent.width - 1px;
        background: Theme.sidebar-border;
    }

    VerticalLayout {
        padding: Theme.space-sm;
        spacing: 2px;
        alignment: start;

        SidebarItem { glyph: "◆"; label: "Conexões"; collapsed: root.collapsed; active: root.active == Section.home; clicked => { root.selected(Section.home); } }
        SidebarItem { glyph: "▮"; label: "Terminal"; collapsed: root.collapsed; active: root.active == Section.terminal; clicked => { root.selected(Section.terminal); } }
        SidebarItem { glyph: "▤"; label: "Arquivos"; collapsed: root.collapsed; active: root.active == Section.files; clicked => { root.selected(Section.files); } }
        SidebarItem { glyph: "✎"; label: "Editor"; collapsed: root.collapsed; active: root.active == Section.editor; clicked => { root.selected(Section.editor); } }
        SidebarItem { glyph: "⚿"; label: "Chaveiro"; collapsed: root.collapsed; active: root.active == Section.keychain; clicked => { root.selected(Section.keychain); } }
        SidebarItem { glyph: "⛨"; label: "Hosts conhecidos"; collapsed: root.collapsed; active: root.active == Section.known-hosts; clicked => { root.selected(Section.known-hosts); } }
        SidebarItem { glyph: "✐"; label: "Notas"; collapsed: root.collapsed; active: root.active == Section.notes; clicked => { root.selected(Section.notes); } }
        SidebarItem { glyph: "⟳"; label: "Sincronização"; collapsed: root.collapsed; active: root.active == Section.sync; clicked => { root.selected(Section.sync); } }
        SidebarItem { glyph: "⚙"; label: "Configurações"; collapsed: root.collapsed; active: root.active == Section.settings; clicked => { root.selected(Section.settings); } }
        SidebarItem { glyph: "◇"; label: "Sobre"; collapsed: root.collapsed; active: root.active == Section.about; clicked => { root.selected(Section.about); } }
    }
}
