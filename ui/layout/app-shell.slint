import { Theme } from "../theme/tokens.slint";
import { Sidebar, Section } from "sidebar.slint";
import { ConnectionRow } from "../models/connection.slint";
import { PageTransition } from "../patterns/page-transition.slint";
import { BlockRow } from "../models/workspace.slint";
import { WorkspacePage } from "../pages/workspace.slint";
import { ConnectionsPage } from "../pages/connections.slint";
import { SessionRow } from "../models/session.slint";
import { TermLine } from "../models/terminal.slint";
import { KeychainRow } from "../models/keychain.slint";
import { KeychainPage } from "../pages/keychain.slint";
import { KnownHostRow } from "../models/session.slint";
import { KnownHostsPage } from "../pages/known-hosts.slint";
import { SettingsDraft } from "../models/settings.slint";
import { SettingsPage } from "../pages/settings.slint";
import { AboutPage } from "../pages/about.slint";
import { LogsPage, LogRow } from "../pages/logs.slint";
import { NoteRow } from "../models/note.slint";
import { NotesPage } from "../pages/notes.slint";
import { FileRow } from "../models/file.slint";
import { TransferRow } from "../models/transfer.slint";

export { Section }

export component AppShell inherits Rectangle {
    in property <bool> sidebar-collapsed: false;
    in property <[BlockRow]> blocks;
    in property <string> workspace-hint;
    in property <[ConnectionRow]> connections;
    in property <int> connection-total;
    in property <int> connection-ssh;
    in property <int> connection-sftp;
    in-out property <string> connection-query;
    in-out property <int> connection-filter;
    in property <[SessionRow]> sessions;
    in property <[TermLine]> terminal-lines;
    in property <string> active-session;
    in property <[KeychainRow]> keychain;
    in property <[KnownHostRow]> known-hosts;
    in property <string> known-hosts-path;
    in property <SettingsDraft> settings;
    in property <string> settings-message;
    in property <string> password-message;
    in property <bool> update-canary;
    in property <string> update-status;
    in property <bool> update-ready;
    in property <string> version;
    in property <string> storage-path;
    in property <[NoteRow]> notes;
    in property <[LogRow]> logs;
    in property <[FileRow]> files;
    in property <string> files-path;
    in property <string> files-message;
    in property <[TransferRow]> transfers;
    in property <string> editor-path;
    in property <image> editor-surface;
    in property <bool> editor-dirty;
    in property <string> editor-message;
    in property <bool> sync-connected;
    in property <bool> sync-busy;
    in property <string> sync-account;
    in property <string> sync-message;
    in property <int> sync-progress;
    in-out property <Section> section: Section.home;

    callback connection-create-requested();
    callback connection-query-changed(string);
    callback connection-filter-changed(int);
    callback connection-connect-requested(string);
    callback connection-edit-requested(string);
    callback connection-delete-requested(string);
    callback block-moved(string, length, length);
    callback block-resized(string, length, length);
    callback block-raised(string);
    callback block-settled();
    callback canvas-resized(length, length);
    callback terminal-resized(string, length, length);
    callback block-minimize-toggled(string);
    callback block-closed(string);
    callback block-add-terminal();
    callback block-add-files();
    callback session-selected(string);
    callback session-closed(string);
    callback terminal-input-sent(string, bool, bool);
    callback keychain-create-requested();
    callback keychain-edit-requested(string);
    callback keychain-delete-requested(string);
    callback known-host-remove-requested(string);
    callback settings-saved(SettingsDraft);
    callback vault-lock-requested();
    callback master-password-changed(string, string, string);
    callback update-check-requested();
    callback update-download-requested();
    callback update-install-requested();
    callback update-channel-changed(bool);
    callback note-create-requested();
    callback note-edit-requested(string);
    callback note-pin-toggled(string);
    callback note-delete-requested(string);
    callback logs-cleared();
    callback file-path-requested(string);
    callback file-parent-requested();
    callback file-reload-requested();
    callback file-folder-created(string);
    callback file-delete-requested(string, bool);
    callback download-requested(string);
    callback upload-requested();
    callback transfers-cleared();
    callback editor-open-requested(string);
    callback editor-key-pressed(string, bool, bool);
    callback editor-clicked(int, int);
    callback editor-resized(int, int);
    callback editor-save-requested();
    callback editor-close-requested();
    callback sync-login-requested();
    callback sync-logout-requested();
    callback sync-push-requested();
    callback sync-pull-requested();
    callback sync-cancel-requested();

    // O canto arredondado a esquerda faz o conteudo flutuar sobre o fundo
    // comum da sidebar e da barra de titulo.
    background: Theme.canvas;
    border-top-left-radius: Theme.radius-lg;
    // O canto inferior direito e o da janela: sem isto o conteudo pintava por
    // cima do arredondamento e deixava o canto quadrado.
    border-bottom-right-radius: Theme.window-radius;
    clip: true;

    Rectangle {
        background: transparent;

        // Trocar de seção troca o modelo deste for, o elemento e recriado e a
        // transicao de entrada toca de novo.
        for key in [root.section]: PageTransition {

            if root.section == Section.workspace: WorkspacePage {
                blocks: root.blocks;
                terminal-lines: root.terminal-lines;
                files: root.files;
                editor-surface: root.editor-surface;
                hint: root.workspace-hint;
                block-moved(id, dx, dy) => { root.block-moved(id, dx, dy); }
                block-resized(id, dx, dy) => { root.block-resized(id, dx, dy); }
                block-raised(id) => { root.block-raised(id); }
                block-settled => { root.block-settled(); }
                canvas-resized(w, h) => { root.canvas-resized(w, h); }
                terminal-resized(id, w, h) => { root.terminal-resized(id, w, h); }
                block-minimize-toggled(id) => { root.block-minimize-toggled(id); }
                block-closed(id) => { root.block-closed(id); }
                terminal-input(text, ctrl, alt) => { root.terminal-input-sent(text, ctrl, alt); }
                file-opened(path) => { root.file-path-requested(path); }
                add-terminal => { root.block-add-terminal(); }
                add-files => { root.block-add-files(); }
            }
            if root.section == Section.home: ConnectionsPage {
                rows: root.connections;
                total: root.connection-total;
                ssh-count: root.connection-ssh;
                sftp-count: root.connection-sftp;
                query <=> root.connection-query;
                filter <=> root.connection-filter;
                query-changed(text) => { root.connection-query-changed(text); }
                filter-changed(value) => { root.connection-filter-changed(value); }
                create-requested => { root.connection-create-requested(); }
                connect-requested(id) => { root.connection-connect-requested(id); }
                edit-requested(id) => { root.connection-edit-requested(id); }
                delete-requested(id) => { root.connection-delete-requested(id); }
            }
            if root.section == Section.keychain: KeychainPage {
                rows: root.keychain;
                create-requested => { root.keychain-create-requested(); }
                edit-requested(id) => { root.keychain-edit-requested(id); }
                delete-requested(id) => { root.keychain-delete-requested(id); }
            }
            if root.section == Section.known-hosts: KnownHostsPage {
                rows: root.known-hosts;
                path: root.known-hosts-path;
                remove-requested(line) => { root.known-host-remove-requested(line); }
            }
            if root.section == Section.notes: NotesPage {
                rows: root.notes;
                create-requested => { root.note-create-requested(); }
                edit-requested(id) => { root.note-edit-requested(id); }
                pin-toggled(id) => { root.note-pin-toggled(id); }
                delete-requested(id) => { root.note-delete-requested(id); }
            }
            if root.section == Section.settings: SettingsPage {
                connection-count: root.connection-total;
                keychain-count: root.keychain.length;
                known-host-count: root.known-hosts.length;
                password-message: root.password-message;
                master-password-changed(old, fresh, confirm) => { root.master-password-changed(old, fresh, confirm); }
                settings: root.settings;
                message: root.settings-message;
                version: root.version;
                canary: root.update-canary;
                update-status: root.update-status;
                update-ready: root.update-ready;
                saved(draft) => { root.settings-saved(draft); }
                vault-lock-requested => { root.vault-lock-requested(); }
                update-check-requested => { root.update-check-requested(); }
                update-download-requested => { root.update-download-requested(); }
                update-install-requested => { root.update-install-requested(); }
                update-channel-changed(canary) => { root.update-channel-changed(canary); }
            }
            if root.section == Section.logs: LogsPage {
                rows: root.logs;
                cleared => { root.logs-cleared(); }
            }
            if root.section == Section.about: AboutPage {
                version: root.version;
                storage-path: root.storage-path;
            }
        }
    }
}
