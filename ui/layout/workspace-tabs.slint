import { Theme } from "../theme/tokens.slint";
import { Type } from "../theme/typography.slint";
import { WorkspaceTab } from "../models/workspace.slint";
import { UiIcon, Icons } from "../components/icon.slint";

component Tab inherits Rectangle {
    in property <WorkspaceTab> data;
    in property <bool> active: false;
    callback selected();
    callback closed();

    width: label.min-width + 72px;
    height: 28px;
    border-radius: Theme.radius-sm;
    background: root.active ? Theme.accent.with-alpha(0.14)
        : touch.has-hover ? Theme.surface
        : transparent;
    border-width: 1px;
    border-color: root.active ? Theme.accent.with-alpha(0.5) : transparent;
    animate background, border-color {
        duration: Theme.motion-fast;
        easing: Theme.ease-smooth;
    }

    // Antes do conteúdo: depois dele, esta área cobriria o botão de fechar.
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.selected(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-xs;
        spacing: Theme.space-sm;

        UiIcon {
            width: 13px;
            height: 13px;
            y: (parent.height - self.height) / 2;
            source: Icons.workspace;
            tint: root.active ? Theme.accent-bright : Theme.text-muted;
        }

        label := Text {
            horizontal-stretch: 1;
            text: root.data.name;
            vertical-alignment: center;
            font-size: Type.caption;
            font-weight: root.active ? Type.weight-medium : Type.weight-regular;
            color: root.active ? Theme.accent-bright : Theme.text-muted;
            overflow: elide;
        }

        Rectangle {
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: close-touch.has-hover ? Theme.danger : transparent;
            animate background { duration: Theme.motion-fast; }

            UiIcon {
                width: 11px;
                height: 11px;
                source: Icons.close;
                tint: close-touch.has-hover ? Theme.text-on-accent
                    : root.active ? Theme.accent-bright
                    : Theme.text-muted;
            }

            close-touch := TouchArea {
                clicked => { root.closed(); }
            }
        }
    }
}

/// Faixa de abas de área de trabalho. Cada aba é uma área com seus blocos; o
/// mais cria uma nova. Sem áreas abertas a faixa é só o mais.
export component WorkspaceTabs inherits HorizontalLayout {
    in property <[WorkspaceTab]> tabs;
    in property <string> active;
    callback selected(string);
    callback closed(string);
    callback created();

    // Centraliza as abas na altura da barra em vez de as encostar no topo.
    padding-top: (Theme.titlebar-height - 28px) / 2;
    padding-bottom: (Theme.titlebar-height - 28px) / 2;
    spacing: Theme.space-xs;
    alignment: start;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    for tab in root.tabs: Tab {
        data: tab;
        active: tab.id == root.active;
        selected => { root.selected(tab.id); }
        closed => { root.closed(tab.id); }
    }

    // Sem moldura: é um afixo da faixa de abas, não um botão por si só.
    Rectangle {
        width: 28px;
        height: 28px;
        border-radius: Theme.radius-sm;
        background: add.has-hover ? Theme.surface : transparent;
        animate background { duration: Theme.motion-fast; }

        UiIcon {
            width: 13px;
            height: 13px;
            source: Icons.plus;
            tint: add.has-hover ? Theme.accent : Theme.text-muted;
        }

        add := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.created(); }
        }
    }
}
