import { Theme } from "theme/tokens.slint";
import { VaultState } from "models/vault.slint";
import { ConnectionRow, ConnectionDraft } from "models/connection.slint";
import { AppShell } from "layout/app-shell.slint";
import { Section } from "layout/sidebar.slint";
import { VaultPage } from "pages/vault.slint";
import { ConnectionForm } from "pages/connection-form.slint";
import { HostChallengeDialog } from "pages/host-challenge.slint";
import { HostChallenge, SessionRow } from "models/session.slint";
import { TermLine } from "models/terminal.slint";

export { Section } from "layout/sidebar.slint";
export { ConnectionRow, ConnectionDraft, VaultState, HostChallenge, SessionRow }
export { TermLine, TermSpan } from "models/terminal.slint";

export component AppWindow inherits Window {
    title: "OpenPtl";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 880px;
    min-height: 560px;
    background: Theme.canvas;

    in-out property <Section> section: Section.home;
    in property <VaultState> vault;
    in property <bool> vault-busy: false;
    in property <string> vault-error;
    in property <[ConnectionRow]> connections;
    in property <bool> form-open: false;
    in property <ConnectionDraft> form-draft;
    in property <string> form-error;
    in property <HostChallenge> challenge;
    in property <[SessionRow]> sessions;
    in property <string> status-message;
    in property <[TermLine]> terminal-lines;
    in property <string> active-session;

    callback vault-submitted(string, string);
    callback connection-create-requested();
    callback connection-connect-requested(string);
    callback connection-edit-requested(string);
    callback connection-delete-requested(string);
    callback connection-saved(ConnectionDraft);
    callback connection-form-dismissed();
    callback challenge-accepted();
    callback challenge-rejected();
    callback session-selected(string);
    callback session-closed(string);
    callback terminal-input-sent(string, bool, bool);

    if root.vault.locked || !root.vault.initialized: VaultPage {
        state: root.vault;
        busy: root.vault-busy;
        error: root.vault-error;
        submitted(password, confirmation) => { root.vault-submitted(password, confirmation); }
    }

    if root.vault.initialized && !root.vault.locked: AppShell {
        section <=> root.section;
        connections: root.connections;
        sessions: root.sessions;
        terminal-lines: root.terminal-lines;
        active-session: root.active-session;
        connection-create-requested => { root.connection-create-requested(); }
        connection-connect-requested(id) => { root.connection-connect-requested(id); }
        connection-edit-requested(id) => { root.connection-edit-requested(id); }
        connection-delete-requested(id) => { root.connection-delete-requested(id); }
        session-selected(id) => { root.session-selected(id); }
        session-closed(id) => { root.session-closed(id); }
        terminal-input-sent(text, ctrl, alt) => { root.terminal-input-sent(text, ctrl, alt); }
    }

    ConnectionForm {
        open: root.form-open;
        draft: root.form-draft;
        error: root.form-error;
        saved(draft) => { root.connection-saved(draft); }
        cancelled => { root.connection-form-dismissed(); }
    }

    HostChallengeDialog {
        challenge: root.challenge;
        accepted => { root.challenge-accepted(); }
        rejected => { root.challenge-rejected(); }
    }
}
