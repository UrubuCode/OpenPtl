import { Theme } from "theme/tokens.slint";
import { Type } from "theme/typography.slint";
import { VaultState } from "models/vault.slint";
import { ConnectionRow, ConnectionDraft } from "models/connection.slint";
import { AppShell } from "layout/app-shell.slint";
import { Section } from "layout/sidebar.slint";
import { TitleBar } from "layout/titlebar.slint";
import { VaultPage } from "pages/vault.slint";
import { ConnectionForm } from "pages/connection-form.slint";
import { HostChallengeDialog } from "pages/host-challenge.slint";
import { HostChallenge, SessionRow } from "models/session.slint";
import { TermLine } from "models/terminal.slint";
import { KeychainRow, KeychainDraft } from "models/keychain.slint";
import { KeychainForm } from "pages/keychain-form.slint";
import { KnownHostRow } from "models/session.slint";
import { SettingsDraft } from "models/settings.slint";
import { NoteRow, NoteDraft } from "models/note.slint";
import { NoteForm } from "pages/note-form.slint";
import { FileRow } from "models/file.slint";
import { TransferRow } from "models/transfer.slint";
import { BlockRow, WorkspaceTab } from "models/workspace.slint";

export { Section } from "layout/sidebar.slint";
export { ConnectionRow, ConnectionDraft, VaultState, HostChallenge, SessionRow }
export { TermLine, TermSpan } from "models/terminal.slint";
export { KeychainRow, KeychainDraft, KnownHostRow, SettingsDraft, NoteRow, NoteDraft, FileRow }
export { TransferRow }
export { BlockRow, BlockKind, WorkspaceTab } from "models/workspace.slint";

export component AppWindow inherits Window {
    title: "OpenPtl";
    no-frame: true;
    default-font-family: Type.family;
    default-font-size: Type.body;
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 880px;
    min-height: 560px;
    background: Theme.canvas;

    in-out property <Section> section: Section.workspace;
    in property <bool> window-maximized: false;
    in-out property <bool> sidebar-collapsed: false;
    in property <[BlockRow]> blocks;
    in property <[WorkspaceTab]> tabs;
    in property <string> active-tab;
    in property <string> workspace-hint;
    in property <VaultState> vault;
    in property <bool> vault-busy: false;
    in property <string> vault-error;
    in property <[ConnectionRow]> connections;
    in property <bool> form-open: false;
    in property <ConnectionDraft> form-draft;
    in property <string> form-error;
    in property <HostChallenge> challenge;
    in property <[SessionRow]> sessions;
    in property <string> status-message;
    in property <[TermLine]> terminal-lines;
    in property <string> active-session;
    in property <[KeychainRow]> keychain;
    in property <bool> keychain-form-open: false;
    in property <KeychainDraft> keychain-draft;
    in property <string> keychain-error;
    in property <[KnownHostRow]> known-hosts;
    in property <string> known-hosts-path;
    in property <SettingsDraft> settings;
    in property <string> settings-message;
    in property <bool> update-canary;
    in property <string> update-status;
    in property <bool> update-ready;
    in property <string> version;
    in property <string> storage-path;
    in property <[NoteRow]> notes;
    in property <bool> note-form-open: false;
    in property <NoteDraft> note-draft;
    in property <string> note-error;
    in property <[FileRow]> files;
    in property <string> files-path;
    in property <string> files-message;
    in property <[TransferRow]> transfers;
    in property <string> editor-path;
    in property <image> editor-surface;
    in property <bool> editor-dirty;
    in property <string> editor-message;
    in property <bool> sync-connected;
    in property <bool> sync-busy;
    in property <string> sync-account;
    in property <string> sync-message;
    in property <int> sync-progress;

    callback window-drag-started();
    callback window-dragged(length, length);
    callback window-minimize();
    callback window-maximize-toggle();
    callback window-close();
    callback tab-selected(string);
    callback tab-closed(string);
    callback tab-created();
    callback block-moved(string, length, length);
    callback block-resized(string, length, length);
    callback block-raised(string);
    callback block-minimize-toggled(string);
    callback block-closed(string);
    callback block-add-terminal();
    callback block-add-files();
    callback vault-submitted(string, string);
    callback connection-create-requested();
    callback connection-connect-requested(string);
    callback connection-edit-requested(string);
    callback connection-delete-requested(string);
    callback connection-saved(ConnectionDraft);
    callback connection-form-dismissed();
    callback challenge-accepted();
    callback challenge-rejected();
    callback session-selected(string);
    callback session-closed(string);
    callback terminal-input-sent(string, bool, bool);
    callback keychain-create-requested();
    callback keychain-edit-requested(string);
    callback keychain-delete-requested(string);
    callback keychain-saved(KeychainDraft);
    callback keychain-form-dismissed();
    callback known-host-remove-requested(string);
    callback settings-saved(SettingsDraft);
    callback vault-lock-requested();
    callback update-check-requested();
    callback update-download-requested();
    callback update-install-requested();
    callback update-channel-changed(bool);
    callback note-create-requested();
    callback note-edit-requested(string);
    callback note-pin-toggled(string);
    callback note-delete-requested(string);
    callback note-saved(NoteDraft);
    callback note-form-dismissed();
    callback file-path-requested(string);
    callback file-parent-requested();
    callback file-reload-requested();
    callback file-folder-created(string);
    callback file-delete-requested(string, bool);
    callback download-requested(string);
    callback upload-requested();
    callback transfers-cleared();
    callback editor-open-requested(string);
    callback editor-key-pressed(string, bool, bool);
    callback editor-clicked(int, int);
    callback editor-resized(int, int);
    callback editor-save-requested();
    callback editor-close-requested();
    callback sync-login-requested();
    callback sync-logout-requested();
    callback sync-push-requested();
    callback sync-pull-requested();
    callback sync-cancel-requested();

    VerticalLayout {
        TitleBar {
            title: "OpenPtl";
            maximized: root.window-maximized;
            drag-started => { root.window-drag-started(); }
            dragged(dx, dy) => { root.window-dragged(dx, dy); }
            minimize-requested => { root.window-minimize(); }
            maximize-toggled => { root.window-maximize-toggle(); }
            close-requested => { root.window-close(); }
            sidebar-toggled => { root.sidebar-collapsed = !root.sidebar-collapsed; }
            tabs: root.tabs;
            active-tab: root.active-tab;
            tab-selected(id) => { root.tab-selected(id); }
            tab-closed(id) => { root.tab-closed(id); }
            tab-created => { root.tab-created(); }
        }

        content := Rectangle {
            vertical-stretch: 1;
            background: Theme.canvas;

            if root.vault.locked || !root.vault.initialized: VaultPage {
                state: root.vault;
                busy: root.vault-busy;
                error: root.vault-error;
                submitted(password, confirmation) => { root.vault-submitted(password, confirmation); }
            }

            if root.vault.initialized && !root.vault.locked: AppShell {
                sidebar-collapsed: root.sidebar-collapsed;
                blocks: root.blocks;
                workspace-hint: root.workspace-hint;
                block-moved(id, dx, dy) => { root.block-moved(id, dx, dy); }
                block-resized(id, dx, dy) => { root.block-resized(id, dx, dy); }
                block-raised(id) => { root.block-raised(id); }
                block-minimize-toggled(id) => { root.block-minimize-toggled(id); }
                block-closed(id) => { root.block-closed(id); }
                block-add-terminal => { root.block-add-terminal(); }
                block-add-files => { root.block-add-files(); }
                section <=> root.section;
                connections: root.connections;
                sessions: root.sessions;
                terminal-lines: root.terminal-lines;
                active-session: root.active-session;
                keychain: root.keychain;
                known-hosts: root.known-hosts;
                known-hosts-path: root.known-hosts-path;
                settings: root.settings;
                settings-message: root.settings-message;
                update-canary: root.update-canary;
                update-status: root.update-status;
                update-ready: root.update-ready;
                version: root.version;
                storage-path: root.storage-path;
                notes: root.notes;
                files: root.files;
                files-path: root.files-path;
                files-message: root.files-message;
                transfers: root.transfers;
                editor-path: root.editor-path;
                editor-surface: root.editor-surface;
                editor-dirty: root.editor-dirty;
                editor-message: root.editor-message;
                sync-connected: root.sync-connected;
                sync-busy: root.sync-busy;
                sync-account: root.sync-account;
                sync-message: root.sync-message;
                sync-progress: root.sync-progress;
                connection-create-requested => { root.connection-create-requested(); }
                connection-connect-requested(id) => { root.connection-connect-requested(id); }
                connection-edit-requested(id) => { root.connection-edit-requested(id); }
                connection-delete-requested(id) => { root.connection-delete-requested(id); }
                session-selected(id) => { root.session-selected(id); }
                session-closed(id) => { root.session-closed(id); }
                terminal-input-sent(text, ctrl, alt) => { root.terminal-input-sent(text, ctrl, alt); }
                keychain-create-requested => { root.keychain-create-requested(); }
                keychain-edit-requested(id) => { root.keychain-edit-requested(id); }
                keychain-delete-requested(id) => { root.keychain-delete-requested(id); }
                known-host-remove-requested(line) => { root.known-host-remove-requested(line); }
                settings-saved(draft) => { root.settings-saved(draft); }
                vault-lock-requested => { root.vault-lock-requested(); }
                update-check-requested => { root.update-check-requested(); }
                update-download-requested => { root.update-download-requested(); }
                update-install-requested => { root.update-install-requested(); }
                update-channel-changed(canary) => { root.update-channel-changed(canary); }
                note-create-requested => { root.note-create-requested(); }
                note-edit-requested(id) => { root.note-edit-requested(id); }
                note-pin-toggled(id) => { root.note-pin-toggled(id); }
                note-delete-requested(id) => { root.note-delete-requested(id); }
                file-path-requested(path) => { root.file-path-requested(path); }
                file-parent-requested => { root.file-parent-requested(); }
                file-reload-requested => { root.file-reload-requested(); }
                file-folder-created(name) => { root.file-folder-created(name); }
                file-delete-requested(path, is-dir) => { root.file-delete-requested(path, is-dir); }
                download-requested(path) => { root.download-requested(path); }
                upload-requested => { root.upload-requested(); }
                transfers-cleared => { root.transfers-cleared(); }
                editor-open-requested(path) => { root.editor-open-requested(path); }
                editor-key-pressed(text, ctrl, shift) => { root.editor-key-pressed(text, ctrl, shift); }
                editor-clicked(x, y) => { root.editor-clicked(x, y); }
                editor-resized(w, h) => { root.editor-resized(w, h); }
                editor-save-requested => { root.editor-save-requested(); }
                editor-close-requested => { root.editor-close-requested(); }
                sync-login-requested => { root.sync-login-requested(); }
                sync-logout-requested => { root.sync-logout-requested(); }
                sync-push-requested => { root.sync-push-requested(); }
                sync-pull-requested => { root.sync-pull-requested(); }
                sync-cancel-requested => { root.sync-cancel-requested(); }
            }
        }
    }

    ConnectionForm {
        open: root.form-open;
        draft: root.form-draft;
        error: root.form-error;
        saved(draft) => { root.connection-saved(draft); }
        cancelled => { root.connection-form-dismissed(); }
    }

    HostChallengeDialog {
        challenge: root.challenge;
        accepted => { root.challenge-accepted(); }
        rejected => { root.challenge-rejected(); }
    }
    KeychainForm {
        open: root.keychain-form-open;
        draft: root.keychain-draft;
        error: root.keychain-error;
        saved(draft) => { root.keychain-saved(draft); }
        cancelled => { root.keychain-form-dismissed(); }
    }
    NoteForm {
        open: root.note-form-open;
        draft: root.note-draft;
        error: root.note-error;
        saved(draft) => { root.note-saved(draft); }
        cancelled => { root.note-form-dismissed(); }
    }
}
