export struct TermSpan {
    text: string,
    // Índice na paleta ANSI de 16 cores, ou -1 para a cor padrão do tema.
    foreground: int,
    background: int,
    bold: bool,
    // Quantas celulas o trecho ocupa; a largura vem daqui, nao do texto.
    cells: int,
    inverse: bool,
}

export struct TermLine {
    spans: [TermSpan],
}
