import { Theme } from "../theme/tokens.slint";
import { Type } from "../theme/typography.slint";
import { KnownHostRow } from "../models/session.slint";
import { UiButton, ButtonTone } from "../components/button.slint";
import { UiCard } from "../components/card.slint";
import { UiBadge, BadgeTone } from "../components/badge.slint";
import { PageHeader } from "../patterns/page-header.slint";
import { ListPanel } from "../patterns/list-panel.slint";

component KnownHostCard inherits UiCard {
    in property <KnownHostRow> data;
    callback remove-requested(string);

    height: 76px;

    HorizontalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-md;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.space-xs;
            alignment: center;

            HorizontalLayout {
                spacing: Theme.space-sm;
                alignment: start;
                Text {
                    text: root.data.host + ":" + root.data.port;
                    vertical-alignment: center;
                    font-size: Type.body;
                    font-weight: Type.weight-medium;
                    color: Theme.text-primary;
                }
                UiBadge { label: root.data.key-type; tone: BadgeTone.neutral; }
            }
            Text {
                text: root.data.fingerprint;
                font-family: Type.mono-family;
                font-size: Type.caption;
                color: Theme.text-muted;
                overflow: elide;
            }
        }

        UiButton {
            label: "Revogar";
            tone: ButtonTone.danger;
            y: (parent.height - self.height) / 2;
            clicked => { root.remove-requested(root.data.line-raw); }
        }
    }
}

export component KnownHostsPage inherits VerticalLayout {
    in property <[KnownHostRow]> rows;
    in property <string> path;
    callback remove-requested(string);

    padding: Theme.space-lg;
    spacing: Theme.space-lg;

    PageHeader {
        title: "Hosts conhecidos";
        subtitle: "Servidores cuja impressão digital você já confirmou. Revogar exige nova confirmação na próxima conexão.";
    }

    if root.path != "": Text {
        text: root.path;
        font-family: Type.mono-family;
        font-size: Type.caption;
        color: Theme.text-muted;
        overflow: elide;
    }

    ListPanel {
        empty: root.rows.length == 0;
        empty-message: "Nenhum host confirmado ainda.";

        for row in root.rows: KnownHostCard {
            data: row;
            remove-requested(line) => { root.remove-requested(line); }
        }
    }
}
