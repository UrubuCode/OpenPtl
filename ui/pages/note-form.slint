import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Type } from "../theme/typography.slint";
import { Palette } from "../theme/palette.slint";
import { NoteDraft } from "../models/note.slint";
import { UiButton, ButtonTone } from "../components/button.slint";
import { UiIcon, Icons } from "../components/icon.slint";

component ColorSwatch inherits Rectangle {
    in property <int> index;
    in property <bool> selected: false;
    callback picked(int);

    width: 20px;
    height: 20px;
    border-radius: 10px;
    background: Palette.note[root.index];
    border-width: root.selected ? 2px : 0px;
    border-color: Theme.text-primary;
    animate border-width { duration: Theme.motion-fast; }

    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.picked(root.index); }
    }
}

/// Editor de nota em painel grande, como era antes do porte: o título na
/// própria barra do topo junto das cores e do salvar, o corpo ocupando quase
/// tudo, e o rodapé lembrando os atalhos.
export component NoteForm inherits Rectangle {
    in property <bool> open: false;
    in property <NoteDraft> draft;
    in property <string> error;
    callback saved(NoteDraft);
    callback cancelled();

    visible: root.open || root.veil > 0.01;
    background: Theme.overlay.with-alpha(0.72 * root.veil);

    property <NoteDraft> edited: root.draft;
    property <float> veil: root.open ? 1.0 : 0.0;
    animate veil {
        duration: Theme.motion-base;
        easing: Theme.ease-smooth;
    }

    TouchArea {
        clicked => { root.cancelled(); }
    }

    panel := Rectangle {
        width: min(parent.width - 2 * Theme.space-xl, 780px);
        height: min(parent.height - 2 * Theme.space-xl, 680px);
        y: (parent.height - self.height) / 2 + (1 - root.veil) * Theme.rise * 2;
        opacity: root.veil;
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border-strong;
        clip: true;
        animate y, opacity {
            duration: Theme.motion-base;
            easing: Theme.ease-out-soft;
        }

        TouchArea { }

        VerticalLayout {
            Rectangle {
                height: 56px;
                vertical-stretch: 0;
                background: Theme.surface-raised;

                HorizontalLayout {
                    padding-left: Theme.space-lg;
                    padding-right: Theme.space-sm;
                    spacing: Theme.space-md;

                    Rectangle {
                        horizontal-stretch: 1;
                        clip: true;

                        if root.edited.title == "": Text {
                            x: 0;
                            text: "Título da nota…";
                            vertical-alignment: center;
                            font-size: Type.title;
                            color: Theme.text-muted;
                        }

                        TextInput {
                            x: 0;
                            width: parent.width;
                            single-line: true;
                            vertical-alignment: center;
                            font-size: Type.title;
                            font-weight: Type.weight-semibold;
                            color: Theme.text-primary;
                            selection-background-color: Theme.accent;
                            text <=> root.edited.title;
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space-xs;
                        for index in 9: ColorSwatch {
                            index: index;
                            selected: index == root.edited.color;
                            picked(value) => { root.edited.color = value; }
                        }
                    }

                    UiButton {
                        compact: true;
                        label: "Salvar";
                        tone: ButtonTone.primary;
                        enabled: root.edited.title != "";
                        clicked => { root.saved(root.edited); }
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius-sm;
                        background: close-touch.has-hover ? Theme.danger : transparent;
                        animate background { duration: Theme.motion-fast; }

                        UiIcon {
                            width: 14px;
                            height: 14px;
                            source: Icons.close;
                            tint: close-touch.has-hover ? Theme.text-on-accent : Theme.text-muted;
                        }

                        close-touch := TouchArea {
                            clicked => { root.cancelled(); }
                        }
                    }
                }
            }

            Rectangle { height: 1px; vertical-stretch: 0; background: Theme.border; }

            Rectangle {
                vertical-stretch: 1;
                background: Theme.canvas;

                ScrollView {
                    x: Theme.space-lg;
                    y: Theme.space-md;
                    width: parent.width - 2 * Theme.space-lg;
                    height: parent.height - 2 * Theme.space-md;

                    TextInput {
                        width: parent.width;
                        single-line: false;
                        wrap: word-wrap;
                        font-size: Type.body;
                        color: Theme.text-primary;
                        selection-background-color: Theme.accent;
                        selection-foreground-color: Theme.text-on-accent;
                        text <=> root.edited.content;
                    }
                }
            }

            Rectangle { height: 1px; vertical-stretch: 0; background: Theme.border; }

            Rectangle {
                height: 34px;
                vertical-stretch: 0;
                background: Theme.surface-raised;

                HorizontalLayout {
                    padding-left: Theme.space-lg;
                    padding-right: Theme.space-lg;

                    Text {
                        horizontal-stretch: 1;
                        text: root.error != "" ? root.error : "Fixe a nota pela lista para mantê-la no topo.";
                        vertical-alignment: center;
                        font-size: Type.caption;
                        color: root.error != "" ? Theme.danger : Theme.text-muted;
                    }

                    Text {
                        text: "Esc cancelar";
                        vertical-alignment: center;
                        font-size: Type.caption;
                        color: Theme.text-muted;
                    }
                }
            }
        }
    }
}
