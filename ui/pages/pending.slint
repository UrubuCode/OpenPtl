import { Theme } from "../theme/tokens.slint";
import { Type } from "../theme/typography.slint";
import { PageHeader } from "../patterns/page-header.slint";

// Marcador explícito para seções ainda não portadas do frontend Tauri.
// Cada uma é substituída por sua própria página em ui/pages/ conforme a migração avança.
export component PendingPage inherits VerticalLayout {
    in property <string> title;

    padding: Theme.space-lg;
    spacing: Theme.space-lg;
    alignment: start;

    PageHeader {
        title: root.title;
        subtitle: "Esta seção ainda não foi migrada para a interface nativa.";
    }
}
