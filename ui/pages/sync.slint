import { Theme } from "../theme/tokens.slint";
import { Type } from "../theme/typography.slint";
import { UiButton, ButtonTone } from "../components/button.slint";
import { UiCard } from "../components/card.slint";
import { UiBadge, BadgeTone } from "../components/badge.slint";
import { PageHeader } from "../patterns/page-header.slint";

component ProgressBar inherits Rectangle {
    in property <int> percent;

    height: 4px;
    border-radius: 2px;
    background: Theme.surface-inset;

    Rectangle {
        x: 0;
        width: parent.width * min(root.percent, 100) / 100;
        height: parent.height;
        border-radius: parent.border-radius;
        background: Theme.accent;
        animate width { duration: Theme.motion-base; }
    }
}

export component SyncPage inherits VerticalLayout {
    in property <bool> connected: false;
    in property <bool> busy: false;
    in property <string> account;
    in property <string> message;
    in property <int> progress;
    callback login-requested();
    callback logout-requested();
    callback push-requested();
    callback pull-requested();
    callback cancel-requested();

    padding: Theme.space-lg;
    spacing: Theme.space-lg;
    alignment: start;

    PageHeader {
        title: "Sincronização";
        subtitle: "Cópia do cofre no seu Google Drive. Os arquivos sobem já criptografados: o Drive nunca vê o conteúdo.";
    }

    UiCard {
        height: account-box.preferred-height + 2 * Theme.space-lg;

        account-box := HorizontalLayout {
            padding: Theme.space-lg;
            spacing: Theme.space-md;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: Theme.space-xs;
                alignment: center;

                HorizontalLayout {
                    spacing: Theme.space-sm;
                    alignment: start;
                    Text {
                        text: root.connected ? root.account : "Nenhuma conta conectada";
                        vertical-alignment: center;
                        font-size: Type.body;
                        font-weight: Type.weight-medium;
                        color: Theme.text-primary;
                    }
                    UiBadge {
                        label: root.connected ? "conectado" : "desconectado";
                        tone: root.connected ? BadgeTone.positive : BadgeTone.neutral;
                    }
                }
                if root.message != "": Text {
                    text: root.message;
                    font-size: Type.caption;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }

            if !root.connected: UiButton {
                label: "Conectar conta";
                tone: ButtonTone.primary;
                enabled: !root.busy;
                clicked => { root.login-requested(); }
            }
            if root.connected: UiButton {
                label: "Desconectar";
                tone: ButtonTone.danger;
                enabled: !root.busy;
                clicked => { root.logout-requested(); }
            }
        }
    }

    if root.busy: ProgressBar { percent: root.progress; }

    HorizontalLayout {
        spacing: Theme.space-sm;
        alignment: start;

        UiButton {
            label: "Enviar para o Drive";
            tone: ButtonTone.primary;
            enabled: root.connected && !root.busy;
            clicked => { root.push-requested(); }
        }
        UiButton {
            label: "Baixar do Drive";
            tone: ButtonTone.neutral;
            enabled: root.connected && !root.busy;
            clicked => { root.pull-requested(); }
        }
        if root.busy: UiButton {
            label: "Cancelar";
            tone: ButtonTone.ghost;
            clicked => { root.cancel-requested(); }
        }
    }

    Text {
        text: "Baixar do Drive substitui o cofre local pela cópia remota.";
        font-size: Type.caption;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
}
