import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Type } from "../theme/typography.slint";
import { ConnectionRow } from "../models/connection.slint";
import { ConnectionGridRow } from "../models/connection-grid.slint";
import { UiButton, ButtonTone } from "../components/button.slint";
import { UiCard } from "../components/card.slint";
import { UiBadge, BadgeTone } from "../components/badge.slint";
import { UiIcon, Icons } from "../components/icon.slint";
import { UiStatCard, StatTone } from "../components/stat-card.slint";
import { UiSearchField } from "../components/search-field.slint";
import { UiSelect, SelectOption } from "../components/select.slint";
import { PageHeader } from "../patterns/page-header.slint";

/// Cartão de um perfil. Compacto e clicável: as ações só aparecem depois do
/// clique, para a grade continuar legível com muitos perfis.
component ConnectionCard inherits UiCard {
    in property <ConnectionRow> data;
    callback opened(string);

    interactive: true;

    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.opened(root.data.id); }
    }

    VerticalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-sm;

        HorizontalLayout {
            spacing: Theme.space-md;
            height: 38px;

            Rectangle {
                width: 38px;
                height: 38px;
                horizontal-stretch: 0;
                border-radius: Theme.radius-md;
                background: Theme.accent.with-alpha(0.14);

                UiIcon {
                    width: 18px;
                    height: 18px;
                    source: Icons.server;
                    tint: Theme.accent-bright;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.data.name;
                    font-size: Type.body;
                    font-weight: Type.weight-semibold;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    text: root.data.host + ":" + root.data.port;
                    font-size: Type.caption;
                    color: Theme.text-muted;
                    overflow: elide;
                }
            }

            VerticalLayout {
                alignment: start;
                HorizontalLayout {
                    spacing: Theme.space-xs;
                    if root.data.has-ssh: UiBadge { label: "SSH"; tone: BadgeTone.positive; }
                    if root.data.has-sftp: UiBadge { label: "SFTP"; tone: BadgeTone.neutral; }
                }
            }
        }

        Rectangle {
            height: 1px;
            vertical-stretch: 0;
            background: Theme.border;
        }

        HorizontalLayout {
            height: 18px;
            spacing: Theme.space-sm;

            UiIcon {
                width: 13px;
                height: 13px;
                y: (parent.height - self.height) / 2;
                source: Icons.user;
                tint: Theme.text-muted;
            }
            Text {
                horizontal-stretch: 1;
                text: root.data.username;
                vertical-alignment: center;
                font-size: Type.caption;
                color: Theme.text-muted;
                overflow: elide;
            }
        }

    }
}

export component ConnectionsPage inherits VerticalLayout {
    in property <[ConnectionGridRow]> grid;
    in property <bool> empty: true;
    in property <int> total;
    in property <int> ssh-count;
    in property <int> sftp-count;
    in-out property <string> query;
    in-out property <string> filter;
    in-out property <string> filter-label;
    callback create-requested();
    callback opened(string);
    callback query-changed(string);
    callback filter-changed(string);

    padding: Theme.space-lg;
    spacing: Theme.space-lg;

    HorizontalLayout {
        PageHeader {
            horizontal-stretch: 1;
            title: "Conexões";
            subtitle: "Gerencie conexões SSH e SFTP em um único painel.";
        }
        UiButton {
            label: "Nova conexão";
            tone: ButtonTone.primary;
            icon: Icons.plus;
            clicked => { root.create-requested(); }
        }
    }

    HorizontalLayout {
        spacing: Theme.space-md;
        vertical-stretch: 0;

        UiSearchField {
            horizontal-stretch: 1;
            placeholder: "Buscar conexões…";
            value <=> root.query;
            changed(text) => { root.query-changed(text); }
        }

        // Lista suspensa e não abas: o produto vai ganhar mais protocolos e uma
        // faixa de abas deixaria de caber.
        UiSelect {
            width: 230px;
            placeholder: "Todos os protocolos";
            options: [
                { id: "ssh", label: "SSH" },
                { id: "sftp", label: "SFTP" },
            ];
            current <=> root.filter;
            current-label <=> root.filter-label;
            selected(id) => { root.filter-changed(id); }
        }
    }

    HorizontalLayout {
        spacing: Theme.space-md;
        vertical-stretch: 0;

        UiStatCard { label: "TOTAL"; value: root.total; }
        UiStatCard { label: "SSH"; value: root.ssh-count; tone: StatTone.accent; }
        UiStatCard { label: "SFTP"; value: root.sftp-count; tone: StatTone.accent; }
        UiStatCard { label: "PROTOCOLOS"; value: 2; tone: StatTone.warning; }
    }

    if root.empty: Rectangle {
        vertical-stretch: 1;
        Text {
            text: root.query == ""
                ? "Nenhuma conexão cadastrada. Crie a primeira."
                : "Nenhuma conexão encontrada para esta busca.";
            font-size: Type.body;
            color: Theme.text-muted;
        }
    }

    if !root.empty: ScrollView {
        vertical-stretch: 1;
        // A grade acompanha a largura visivel; sem isto ela adota a largura
        // minima dos cartoes e as tres colunas viram duas largas.
        viewport-width: self.visible-width;

        VerticalLayout {
            spacing: Theme.space-md;
            alignment: start;

            for line in root.grid: HorizontalLayout {
                spacing: Theme.space-md;
                height: 124px;

                for cell in line.cells: ConnectionCard {
                    data: cell;
                    opened(id) => { root.opened(id); }
                }

                // Preenche o resto da linha para o ultimo cartao nao esticar
                // pela largura toda quando sobram menos de tres.
                Rectangle { horizontal-stretch: 3 - line.cells.length; }
            }
        }
    }
}
