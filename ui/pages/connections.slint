import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme/tokens.slint";
import { Type } from "../theme/typography.slint";
import { ConnectionRow } from "../models/connection.slint";
import { UiButton, ButtonTone } from "../components/button.slint";
import { UiCard } from "../components/card.slint";
import { UiBadge, BadgeTone } from "../components/badge.slint";
import { UiIcon, Icons } from "../components/icon.slint";
import { UiStatCard, StatTone } from "../components/stat-card.slint";
import { UiSearchField } from "../components/search-field.slint";
import { UiSegmented } from "../components/segmented.slint";
import { PageHeader } from "../patterns/page-header.slint";

/// Cartão de um perfil. Em grade, não em linha larga: assim cabem vários por
/// tela e o olho percorre a lista de uma vez, como era antes do porte.
component ConnectionCard inherits UiCard {
    in property <ConnectionRow> data;
    callback connect-requested(string);
    callback edit-requested(string);
    callback delete-requested(string);

    height: 132px;
    interactive: true;

    VerticalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-sm;

        HorizontalLayout {
            spacing: Theme.space-md;

            Rectangle {
                width: 38px;
                height: 38px;
                horizontal-stretch: 0;
                border-radius: Theme.radius-md;
                background: Theme.accent.with-alpha(0.14);

                UiIcon {
                    width: 18px;
                    height: 18px;
                    source: Icons.server;
                    tint: Theme.accent-bright;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.data.name;
                    font-size: Type.body;
                    font-weight: Type.weight-semibold;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    text: root.data.host + ":" + root.data.port;
                    font-size: Type.caption;
                    color: Theme.text-muted;
                    overflow: elide;
                }
            }

            VerticalLayout {
                alignment: start;
                HorizontalLayout {
                    spacing: Theme.space-xs;
                    if root.data.has-ssh: UiBadge { label: "SSH"; tone: BadgeTone.positive; }
                    if root.data.has-sftp: UiBadge { label: "SFTP"; tone: BadgeTone.neutral; }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        HorizontalLayout {
            spacing: Theme.space-sm;

            UiIcon {
                width: 13px;
                height: 13px;
                y: (parent.height - self.height) / 2;
                source: Icons.user;
                tint: Theme.text-muted;
            }
            Text {
                horizontal-stretch: 1;
                text: root.data.username;
                vertical-alignment: center;
                font-size: Type.caption;
                color: Theme.text-muted;
                overflow: elide;
            }

            UiButton {
                compact: true;
                label: "Conectar";
                tone: ButtonTone.primary;
                clicked => { root.connect-requested(root.data.id); }
            }
            UiButton {
                compact: true;
                label: "Editar";
                tone: ButtonTone.ghost;
                clicked => { root.edit-requested(root.data.id); }
            }
            UiButton {
                compact: true;
                label: "Excluir";
                tone: ButtonTone.danger;
                clicked => { root.delete-requested(root.data.id); }
            }
        }
    }
}

export component ConnectionsPage inherits VerticalLayout {
    in property <[ConnectionRow]> rows;
    in property <int> total;
    in property <int> ssh-count;
    in property <int> sftp-count;
    in-out property <string> query;
    in-out property <int> filter: 0;
    callback create-requested();
    callback connect-requested(string);
    callback edit-requested(string);
    callback delete-requested(string);
    callback query-changed(string);
    callback filter-changed(int);

    padding: Theme.space-lg;
    spacing: Theme.space-lg;

    // O segmentado guarda a escolha em si mesmo; o aviso e que refaz a lista.
    changed filter => { root.filter-changed(root.filter); }

    HorizontalLayout {
        PageHeader {
            horizontal-stretch: 1;
            title: "Conexões";
            subtitle: "Gerencie conexões SSH e SFTP em um único painel.";
        }
        UiButton {
            label: "Nova conexão";
            tone: ButtonTone.primary;
            icon: Icons.plus;
            clicked => { root.create-requested(); }
        }
    }

    HorizontalLayout {
        spacing: Theme.space-md;
        vertical-stretch: 0;

        UiSearchField {
            horizontal-stretch: 1;
            placeholder: "Buscar conexões…";
            value <=> root.query;
            changed(text) => { root.query-changed(text); }
        }

        UiSegmented {
            width: 280px;
            options: ["Todos", "SSH", "SFTP"];
            current <=> root.filter;
        }
    }

    HorizontalLayout {
        spacing: Theme.space-md;
        vertical-stretch: 0;

        UiStatCard { label: "TOTAL"; value: root.total; }
        UiStatCard { label: "SSH"; value: root.ssh-count; tone: StatTone.accent; }
        UiStatCard { label: "SFTP"; value: root.sftp-count; tone: StatTone.accent; }
        UiStatCard {
            label: "PROTOCOLOS";
            value: 2;
            tone: StatTone.warning;
        }
    }

    if root.rows.length == 0: Rectangle {
        vertical-stretch: 1;
        Text {
            text: root.query == ""
                ? "Nenhuma conexão cadastrada. Crie a primeira."
                : "Nenhuma conexão encontrada para esta busca.";
            font-size: Type.body;
            color: Theme.text-muted;
        }
    }

    if root.rows.length > 0: ScrollView {
        vertical-stretch: 1;

        // Grade de duas colunas: a lista respira e ainda cabe muita coisa.
        VerticalLayout {
            spacing: Theme.space-md;
            alignment: start;

            for row in root.rows: ConnectionCard {
                data: row;
                connect-requested(id) => { root.connect-requested(id); }
                edit-requested(id) => { root.edit-requested(id); }
                delete-requested(id) => { root.delete-requested(id); }
            }
        }
    }
}
