export global Type {
    // Inter era a fonte do design anterior; a fallback do sistema entra quando
    // ela não estiver instalada.
    out property <string> family: "Inter";
    out property <string> mono-family: "Cascadia Code";

    out property <length> display: 20px;
    out property <length> title: 15px;
    out property <length> body: 13px;
    out property <length> label: 12px;
    out property <length> caption: 11px;

    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
    out property <int> weight-bold: 700;
}
