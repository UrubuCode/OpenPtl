export global Theme {
    out property <color> canvas: #0d131c;
    out property <color> surface: #151e2a;
    out property <color> surface-raised: #182230;
    out property <color> surface-inset: #1c2837;
    out property <color> overlay: #060a11;

    out property <color> border: #29384a;
    out property <color> border-strong: #3a4b60;

    out property <color> text-primary: #edf3fa;
    out property <color> text-secondary: #aebdd0;
    out property <color> text-muted: #8f9db1;
    out property <color> text-on-accent: #f5f9ff;

    out property <color> accent: #3f7fc2;
    out property <color> accent-bright: #84bbff;
    out property <color> accent-pressed: #2e5f94;
    out property <color> positive: #86dfae;
    out property <color> warning: #ffd782;
    out property <color> danger: #ff969f;
    out property <color> danger-surface: #7f3b4a;

    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 20px;
    out property <length> space-xl: 32px;

    out property <length> radius-sm: 6px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 14px;

    out property <length> control-height: 40px;
    out property <length> sidebar-width: 232px;
    out property <length> header-height: 48px;

    out property <duration> motion-fast: 120ms;
    out property <duration> motion-base: 200ms;
}
